# Copia este archivo como .env (en la raíz del repositorio) y pon tu clave de Gemini:
# https://aistudio.google.com/apikey
# Solo la usa el asistente del tablero; sin ella todo lo demás funciona 100% local.
APIGEMINI=

# Opcionales (ver "Asistente" en motor-procesamiento/README.md)
# GEMINI_MODELO=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# GEMINI_EMBEDDINGS=gemini-embedding-001
# GEMINI_RAZONAMIENTO=low
